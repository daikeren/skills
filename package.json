{
  "name": "engineering-judgment-skills",
  "version": "0.1.0",
  "private": false,
  "description": "Agent skills for product, architecture, security, operations, and delivery judgment.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/daikeren/skills.git"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude-code",
    "opencode",
    "pi",
    "software-engineering",
    "software-delivery"
  ],
  "scripts": {
    "validate": "node scripts/validate-skills.js && node scripts/validate-commands.js",
    "sync-commands": "node scripts/sync-commands.js",
    "eval": "node scripts/run-evals.js",
    "eval:live": "node scripts/run-live-evals.js",
    "extract:codex": "node scripts/extract-codex-workflows.js",
    "link": "node scripts/link-skills.js",
    "release:prepare": "node scripts/release.js"
