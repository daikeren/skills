  "files": [
    "README.md",
    "CHANGELOG.md",
    "skills/",
    "commands/",
    "references/",
    "evals/cases/",
    "evals/fixtures/",
    "evals/results/.gitkeep",
    "scripts/",
    ".codex-plugin/",
    ".claude-plugin/",
    ".claude/",
    ".opencode/",
    ".pi/"
  ]
}
